# 生产环境变量样例：复制为 .env.prod 后填入真实值。
# 敏感项务必替换，切勿提交真实值到仓库。

# PostgreSQL（仅容器网络内使用）
POSTGRES_USER=thingsboard
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=thingsboard

# JWT 签名密钥（至少 32 字节随机串，所有服务必须一致）
JWT_SECRET=CHANGE_ME_at_least_32_chars_random_secret

# 首次 seed 的 sysadmin 密码（至少 12 字节）与 core/EDQS 内部 API 密钥
TB_SYSADMIN_PASSWORD=CHANGE_ME_sysadmin_password
TB_EDQS_API_KEY=CHANGE_ME_edqs_api_key

# Redis 口令与 Kafka SASL/PLAIN 凭据：只用字母数字（会拼进 URL 与 JAAS 配置），如 openssl rand -hex 32
REDIS_PASSWORD=CHANGE_ME_redis_password
KAFKA_USERNAME=thingsboard
KAFKA_PASSWORD=CHANGE_ME_kafka_password

# 应用镜像（docker build -f docker/Dockerfile -t thingsboard-rs:latest .）
APP_IMAGE=thingsboard-rs:latest

# 日志级别
RUST_LOG=info

# 传输层每租户上行限流（msg/s，0=不限）：共享值经 Redis 跨全部传输实例合计
TB_TRANSPORT_SHARED_RATE_LIMIT_PER_TENANT=1000
TB_TRANSPORT_RATE_LIMIT_PER_TENANT=1000
TB_COAP_MAX_REQUESTS_PER_SEC=10000

# Housekeeper 保留策略
HOUSEKEEPER_INTERVAL_SEC=3600
TS_TTL_DAYS=0
DEBUG_EVENT_TTL_DAYS=7
ALARM_TTL_DAYS=0
