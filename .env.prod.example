# 生产环境变量样例：复制为 .env.prod 后填入真实值。
# 敏感项务必替换，切勿提交真实值到仓库。

# PostgreSQL（仅容器网络内使用）
POSTGRES_USER=thingsboard
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=thingsboard

# JWT 签名密钥（至少 32 字节随机串，所有服务必须一致）
JWT_SECRET=CHANGE_ME_at_least_32_chars_random_secret

# 应用镜像（docker build -f docker/Dockerfile -t thingsboard-rs:latest .）
APP_IMAGE=thingsboard-rs:latest

# 日志级别
RUST_LOG=info

# Housekeeper 保留策略
HOUSEKEEPER_INTERVAL_SEC=3600
TS_TTL_DAYS=0
DEBUG_EVENT_TTL_DAYS=7
ALARM_TTL_DAYS=0
